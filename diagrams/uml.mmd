classDiagram
    class Owner {
        +name: str
        +preferences: list[str]
        +pets: list[Pet]
        +add_pet(pet)
        +update_preferences(preferences)
    }

    class Pet {
        +name: str
        +species: str
        +tasks: list[Task]
        +add_task(task)
        +remove_task(task)
    }

    class Task {
        +title: str
        +duration_minutes: int
        +priority: str
        +scheduled: bool
        +start_time: time (optional)
        +end_time: time (optional)
        +reason: str
    }

    class Scheduler {
        +create_daily_schedule(owner, pet, start_time, time_budget_minutes) list[Task]
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : tracks
    Scheduler ..> Owner : reads preferences
    Scheduler ..> Pet : reads tasks
    Scheduler ..> Task : orders and schedules

    %% Generate a schedule for one selected pet and one day; each Pet belongs to one Owner.
    %% The time budget starts at start_time and is capped by the time remaining until midnight.
    %% Higher-priority tasks come first; preferences are soft tie-breakers for equal priorities.
    %% Scheduled tasks have start/end times; tasks that do not fit have scheduled=false and a reason.
    %% Task priority is low, medium, or high. Separate DailyPlan and PlanItem classes are omitted.